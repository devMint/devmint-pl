{
  "name": "@devmint/devmint-pl",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "wireit",
    "astro": "astro",
    "typecheck": "wireit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "wireit": {
    "typecheck": {
      "command": "wrangler types",
      "files": [
        "wrangler.toml",
        "src/**/*"
      ],
      "output": [
        "worker-configuration.d.ts"
      ]
    },
    "build": {
      "command": "astro build",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "worker-configuration.d.ts",
        "src/**/*",
        "astro.config.mjs"
      ],
      "output": [
        "dist"
      ]
    }
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.12",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.16.0",
    "astro-favicons": "^3.1.5",
    "astro-og": "^0.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animated": "^2.0.0"
  },
  "devDependencies": {
    "@devmint/config-eslint": "workspace:*",
    "@devmint/config-prettier": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "sharp": "^0.34.5",
    "typescript": "catalog:",
    "wireit": "^0.14.12",
    "wrangler": "^4.50.0"
  }
}
