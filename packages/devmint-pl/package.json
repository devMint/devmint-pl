{
  "name": "@devmint/devmint-pl",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "wireit",
    "astro": "astro",
    "deploy": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "typecheck": {
      "command": "wrangler types",
      "files": [
        "wrangler.toml",
        "src/**/*"
      ],
      "output": [
        "worker-configuration.d.ts"
      ]
    },
    "build": {
      "command": "astro build",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "worker-configuration.d.ts",
        "src/**/*",
        "astro.config.mjs"
      ],
      "output": [
        "dist"
      ]
    }
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.15.5",
    "astro-favicons": "^3.1.5",
    "astro-og": "^0.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animated": "^2.0.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wireit": "^0.14.12",
    "wrangler": "^4.47.0"
  }
}
