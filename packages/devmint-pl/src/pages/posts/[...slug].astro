---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Comments from '../../components/Comments.astro'
import PostHead from '../../components/head/PostHead.astro'
import Layout from '../../components/Layout.astro'
import Post from '../../components/Post.astro'
import PostSocial from '../../components/PostSocial.astro'

export async function getStaticPaths() {
  const posts = await getCollection('posts')

  return posts
    .filter((post) => post.data.language === 'en')
    .map((post) => ({
      params: { slug: post.data.slug },
      props: post,
    }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content } = await render(post)
---

<Layout description={post.data.description} language={post.data.language} title={post.data.title}>
  <PostHead description={post.data.description} image={post.data.meta.image} slot="head" title={post.data.title} />
  <Post class="enter-page m-auto max-w-3xl pl-4 pr-4" post={post.data}>
    <Content />
  </Post>

  {
    post.data.social.length > 0 && (
      <div class="enter-page m-auto max-w-3xl pb-4">
        <PostSocial socials={post.data.social} />
      </div>
    )
  }

  <div class="enter-page m-auto max-w-3xl pl-4 pr-4 pt-4 border-t border-theme-black">
    <Comments language={post.data.language} />
  </div>
</Layout>
